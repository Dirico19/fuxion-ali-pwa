@page "/login"
@using Fuxion.Ali.Contracts.Auth.Login
@layout LoginLayout
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IValidator<LoginRequest> Validator
@inject IAuthService AuthService

<PageTitle>Login</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="align-self-center">
    <MudCard Elevation="3" Class="pa-2">
        <MudCardHeader Class="d-flex justify-center">
            <MudImage Src="/icon-512.png" Alt="Logo" Height="50" />
        </MudCardHeader>

        <MudCardContent>
            <MudForm @ref="form" Model="_model" Validation="Validator.ValidateValue()" ValidationDelay="0"
                     Spacing="3">
                <MudText Typo="Typo.h5" Align="Align.Center">Iniciar sesión</MudText>

                <MudTextField @bind-Value="_model.Username"
                              Label="Usuario"
                              For="@(() => _model.Username)"
                              Required
                              Immediate
                              ShrinkLabel
                              Variant="Variant.Outlined"
                              FullWidth
                              Margin="Margin.Dense" 
                              />

                <MudTextField @bind-Value="_model.Password"
                              Label="Contraseña"
                              For="@(() => _model.Password)"
                              Required
                              Immediate
                              ShrinkLabel
                              Variant="Variant.Outlined"
                              FullWidth
                              Margin="Margin.Dense" 
                              InputType="_passwordInputType"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordAdornmentIcon" 
                              OnAdornmentClick="TogglePasswordVisibility"
                              IconSize="Size.Small"
                              />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="_loading"
                           OnClick="HandleLogin"
                           FullWidth="true">
                    <MudText>Iniciar sesión</MudText>
                    @if (_loading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate Class="ml-2" />
                    }
                </MudButton>
            </MudForm>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private LoginRequest _model = new();
    private MudForm form = null!;

    private InputType _passwordInputType { get; set; }  = InputType.Password;
    private string _passwordAdornmentIcon { get; set; } = Icons.Material.Filled.Visibility;
    private bool _loading = false;

    private async Task HandleLogin()
    {
        _loading = true;
        await form.Validate();
        if (!form.IsValid)
        {
            Snackbar.Add("Por favor, completa todos los campos correctamente.", MudBlazor.Severity.Error);
            _loading = false;
            return;
        }

        var result = await AuthService.LoginAsync(_model);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Message!, MudBlazor.Severity.Error);
            _loading = false;
            return;
        }

        Snackbar.Add(result.Message ?? "Inicio de sesión exitoso!", MudBlazor.Severity.Success);
        _loading = false;

        NavigationManager.NavigateTo("/");
    }

    private void TogglePasswordVisibility()
    {
        if (_passwordInputType == InputType.Password)
        {
            _passwordInputType = InputType.Text;
            _passwordAdornmentIcon = Icons.Material.Filled.VisibilityOff;
        }
        else
        {
            _passwordInputType = InputType.Password;
            _passwordAdornmentIcon = Icons.Material.Filled.Visibility;
        }
    }
}
